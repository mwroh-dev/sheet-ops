{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UseEnvelopeV2",
  "type": "object",
  "required": [
    "scenario_id",
    "request",
    "input_file",
    "output_file"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "request": {
      "$ref": "request_ref.schema.json"
    },
    "input_file": {
      "type": "string",
      "minLength": 1
    },
    "output_file": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
