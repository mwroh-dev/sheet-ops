{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheet-ops.local/agents/request-compiler/contract/compiler_decision.schema.json",
  "title": "RequestCompilerDecision",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": { "enum": ["compiled", "needs_human_checkpoint", "blocked"] },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "checkpoint": {
      "type": "object",
      "required": ["kind", "question", "options"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "blocked": {
      "type": "object",
      "required": ["reason_codes"],
      "properties": {
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "required": ["matched_paragraph_count"],
      "properties": {
        "matched_paragraph_count": { "type": "integer", "minimum": 0 },
        "applied_defaults": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "ignored_preferences": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "conflict_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "template_class_plan": {
      "type": "object",
      "required": ["organism_id", "operation_sequence", "required_verifier_specs"],
      "properties": {
        "organism_id": { "type": "string", "minLength": 1 },
        "operation_sequence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_verifier_specs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "non_claims": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "compiled" }
        },
        "required": ["status"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["checkpoint"] },
            { "required": ["blocked"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "needs_human_checkpoint" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["checkpoint"],
        "not": { "required": ["blocked"] }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "blocked" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["blocked"],
        "not": { "required": ["checkpoint"] }
      }
    }
  ],
  "additionalProperties": false
}
