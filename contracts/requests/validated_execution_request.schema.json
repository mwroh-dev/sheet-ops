{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheet-ops.local/contracts/requests/validated_execution_request.schema.json",
  "title": "ValidatedExecutionRequest",
  "oneOf": [
    {
      "$ref": "#/$defs/validated_execution_request_group_summary"
    },
    {
      "$ref": "#/$defs/validated_execution_request_threshold_highlight"
    },
    {
      "$ref": "#/$defs/validated_execution_request_join_lookup"
    },
    {
      "$ref": "#/$defs/validated_execution_request_structured_row_append"
    },
    {
      "$ref": "#/$defs/validated_execution_request_formula_extension"
    },
    {
      "$ref": "#/$defs/validated_execution_request_data_validation"
    },
    {
      "$ref": "#/$defs/validated_execution_request_period_copy"
    },
    {
      "$ref": "#/$defs/validated_execution_request_formula_protection"
    },
    {
      "$ref": "#/$defs/validated_execution_request_header_normalization"
    },
    {
      "$ref": "#/$defs/validated_execution_request_period_roll_forward"
    },
    {
      "$ref": "#/$defs/validated_execution_request_table_reconciliation"
    },
    {
      "$ref": "#/$defs/validated_execution_request_printable_form"
    }
  ],
  "$defs": {
    "compare_mapping": {
      "type": "object",
      "required": [
        "left_column",
        "right_column"
      ],
      "properties": {
        "left_column": {
          "type": "string",
          "minLength": 1
        },
        "right_column": {
          "type": "string",
          "minLength": 1
        },
        "as": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "form_field_binding": {
      "type": "object",
      "required": [
        "label",
        "source_cell",
        "label_cell",
        "value_cell"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "source_sheet": {
          "type": "string",
          "minLength": 1
        },
        "source_cell": {
          "type": "string",
          "minLength": 1
        },
        "label_cell": {
          "type": "string",
          "minLength": 1
        },
        "value_cell": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "form_table_binding": {
      "type": "object",
      "required": [
        "source_sheet",
        "source_columns",
        "header_start",
        "data_start"
      ],
      "properties": {
        "source_sheet": {
          "type": "string",
          "minLength": 1
        },
        "source_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "header_start": {
          "type": "string",
          "minLength": 1
        },
        "data_start": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "validated_execution_request_base": {
      "type": "object",
      "required": [
        "scenario_id",
        "execution_kind",
        "request_kind",
        "input_file",
        "source_sheet",
        "output_file"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "execution_kind": {
          "const": "composition"
        },
        "request_kind": {
          "enum": [
            "structured_use_request",
            "prompt_text"
          ]
        },
        "input_file": {
          "type": "string",
          "minLength": 1
        },
        "source_sheet": {
          "type": "string",
          "minLength": 1
        },
        "output_file": {
          "type": "string",
          "minLength": 1
        },
        "request_text": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "request_kind": {
                "const": "structured_use_request"
              }
            },
            "required": [
              "request_kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "request_text"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "request_kind": {
                "const": "prompt_text"
              }
            },
            "required": [
              "request_kind"
            ]
          },
          "then": {
            "required": [
              "request_text"
            ]
          }
        }
      ]
    },
    "validated_execution_request_group_summary_fields": {
      "type": "object",
      "required": [
        "composition_kind",
        "target_sheet",
        "summary_mode",
        "group_by",
        "metrics"
      ],
      "properties": {
        "composition_kind": {
          "const": "group_summary"
        },
        "target_sheet": {
          "type": "string",
          "minLength": 1
        },
        "summary_mode": {
          "enum": [
            "values",
            "formulas"
          ]
        },
        "filters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "column",
              "op",
              "value"
            ],
            "properties": {
              "column": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "group_by": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "column",
              "op",
              "as"
            ],
            "properties": {
              "column": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "enum": [
                  "sum",
                  "count"
                ]
              },
              "as": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "validated_execution_request_group_summary": {
      "allOf": [
        {
          "$ref": "#/$defs/validated_execution_request_base"
        },
        {
          "$ref": "#/$defs/validated_execution_request_group_summary_fields"
        }
      ],
      "unevaluatedProperties": false
    },
    "validated_execution_request_threshold_highlight_fields": {
      "type": "object",
      "required": [
        "composition_kind",
        "target_column",
        "operator",
        "threshold"
      ],
      "properties": {
        "composition_kind": {
          "const": "threshold_highlight"
        },
        "target_column": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            ">",
            ">=",
            "<",
            "<=",
            "=",
            "=="
          ]
        },
        "threshold": {
          "type": "number"
        },
        "highlight_color": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validated_execution_request_threshold_highlight": {
      "allOf": [
        {
          "$ref": "#/$defs/validated_execution_request_base"
        },
        {
          "$ref": "#/$defs/validated_execution_request_threshold_highlight_fields"
        }
      ],
      "unevaluatedProperties": false
    },
    "validated_execution_request_join_lookup_fields": {
      "type": "object",
      "required": [
        "composition_kind",
        "target_sheet",
        "lookup_sheet",
        "join_key",
        "append_lookup_columns"
      ],
      "properties": {
        "composition_kind": {
          "const": "join_lookup"
        },
        "lookup_sheet": {
          "type": "string",
          "minLength": 1
        },
        "join_key": {
          "type": "string",
          "minLength": 1
        },
        "target_sheet": {
          "type": "string",
          "minLength": 1
        },
        "include_source_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "append_lookup_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validated_execution_request_join_lookup": {
      "allOf": [
        {
          "$ref": "#/$defs/validated_execution_request_base"
        },
        {
          "$ref": "#/$defs/validated_execution_request_join_lookup_fields"
        }
      ],
      "unevaluatedProperties": false
    },
    "validated_execution_request_structured_row_append_fields": {
      "type": "object",
      "required": [
        "composition_kind",
        "include_source_columns",
        "values"
      ],
      "properties": {
        "composition_kind": {
          "const": "structured_row_append"
        },
        "include_source_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "cell",
              "value"
            ],
            "properties": {
              "cell": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "validated_execution_request_structured_row_append": {
      "allOf": [
        {
          "$ref": "#/$defs/validated_execution_request_base"
        },
        {
          "$ref": "#/$defs/validated_execution_request_structured_row_append_fields"
        }
      ],
      "unevaluatedProperties": false
    },
    "validated_execution_request_formula_extension_fields": {
      "type": "object",
      "required": [
        "composition_kind",
        "formula_source_row",
        "target_rows",
        "formula_columns"
      ],
      "properties": {
        "composition_kind": {
          "const": "formula_extension"
        },
        "formula_source_row": {
          "type": "integer",
          "minimum": 1
        },
        "target_rows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "formula_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validated_execution_request_formula_extension": {
      "allOf": [
        {
          "$ref": "#/$defs/validated_execution_request_base"
        },
        {
          "$ref": "#/$defs/validated_execution_request_formula_extension_fields"
        }
      ],
      "unevaluatedProperties": false
    },
    "validated_execution_request_data_validation_fields": {
      "type": "object",
      "required": [
        "composition_kind",
        "validation_rule"
      ],
      "properties": {
        "composition_kind": {
          "const": "data_validation"
        },
        "validation_rule": {
          "type": "object",
          "required": [
            "ranges",
            "rule_type",
            "allowed_values",
            "allow_blank"
          ],
          "properties": {
            "ranges": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rule_type": {
              "const": "list"
            },
            "allowed_values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allow_blank": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "validated_execution_request_data_validation": {
      "allOf": [
        {
          "$ref": "#/$defs/validated_execution_request_base"
        },
        {
          "$ref": "#/$defs/validated_execution_request_data_validation_fields"
        }
      ],
      "unevaluatedProperties": false
    },
    "validated_execution_request_period_copy_fields": {
      "type": "object",
      "required": [
        "composition_kind",
        "target_sheet"
      ],
      "properties": {
        "composition_kind": {
          "const": "period_copy"
        },
        "target_sheet": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validated_execution_request_period_copy": {
      "allOf": [
        {
          "$ref": "#/$defs/validated_execution_request_base"
        },
        {
          "$ref": "#/$defs/validated_execution_request_period_copy_fields"
        }
      ],
      "unevaluatedProperties": false
    },
    "validated_execution_request_formula_protection_fields": {
      "type": "object",
      "required": [
        "composition_kind",
        "protection_rule"
      ],
      "properties": {
        "composition_kind": {
          "const": "formula_protection"
        },
        "protection_rule": {
          "type": "object",
          "required": [
            "formula_ranges"
          ],
          "properties": {
            "formula_ranges": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "input_ranges": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "password": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "validated_execution_request_formula_protection": {
      "allOf": [
        {
          "$ref": "#/$defs/validated_execution_request_base"
        },
        {
          "$ref": "#/$defs/validated_execution_request_formula_protection_fields"
        }
      ],
      "unevaluatedProperties": false
    },
    "validated_execution_request_header_normalization_fields": {
      "type": "object",
      "required": [
        "composition_kind",
        "header_row",
        "header_mappings"
      ],
      "properties": {
        "composition_kind": {
          "const": "header_normalization"
        },
        "header_row": {
          "type": "integer",
          "minimum": 1
        },
        "header_mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "validated_execution_request_header_normalization": {
      "allOf": [
        {
          "$ref": "#/$defs/validated_execution_request_base"
        },
        {
          "$ref": "#/$defs/validated_execution_request_header_normalization_fields"
        }
      ],
      "unevaluatedProperties": false
    },
    "validated_execution_request_period_roll_forward_fields": {
      "type": "object",
      "required": [
        "composition_kind",
        "target_sheet",
        "carry_forward_mappings"
      ],
      "properties": {
        "composition_kind": {
          "const": "period_roll_forward"
        },
        "target_sheet": {
          "type": "string",
          "minLength": 1
        },
        "carry_forward_mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "from_cell",
              "to_cell"
            ],
            "properties": {
              "from_sheet": {
                "type": "string",
                "minLength": 1
              },
              "from_cell": {
                "type": "string",
                "minLength": 1
              },
              "to_sheet": {
                "type": "string",
                "minLength": 1
              },
              "to_cell": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "validated_execution_request_period_roll_forward": {
      "allOf": [
        {
          "$ref": "#/$defs/validated_execution_request_base"
        },
        {
          "$ref": "#/$defs/validated_execution_request_period_roll_forward_fields"
        }
      ],
      "unevaluatedProperties": false
    },
    "validated_execution_request_table_reconciliation_fields": {
      "type": "object",
      "required": [
        "composition_kind",
        "lookup_sheet",
        "target_sheet",
        "left_key",
        "right_key",
        "compare_mappings"
      ],
      "properties": {
        "composition_kind": {
          "const": "table_reconciliation"
        },
        "lookup_sheet": {
          "type": "string",
          "minLength": 1
        },
        "target_sheet": {
          "type": "string",
          "minLength": 1
        },
        "left_key": {
          "type": "string",
          "minLength": 1
        },
        "right_key": {
          "type": "string",
          "minLength": 1
        },
        "compare_mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/compare_mapping"
          }
        }
      }
    },
    "validated_execution_request_table_reconciliation": {
      "allOf": [
        {
          "$ref": "#/$defs/validated_execution_request_base"
        },
        {
          "$ref": "#/$defs/validated_execution_request_table_reconciliation_fields"
        }
      ],
      "unevaluatedProperties": false
    },
    "validated_execution_request_printable_form_fields": {
      "type": "object",
      "required": [
        "composition_kind",
        "target_sheet",
        "form_title",
        "print_area",
        "field_bindings",
        "table_binding"
      ],
      "properties": {
        "composition_kind": {
          "const": "printable_form"
        },
        "target_sheet": {
          "type": "string",
          "minLength": 1
        },
        "form_title": {
          "type": "string",
          "minLength": 1
        },
        "print_area": {
          "type": "string",
          "minLength": 1
        },
        "field_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/form_field_binding"
          }
        },
        "table_binding": {
          "$ref": "#/$defs/form_table_binding"
        }
      }
    },
    "validated_execution_request_printable_form": {
      "allOf": [
        {
          "$ref": "#/$defs/validated_execution_request_base"
        },
        {
          "$ref": "#/$defs/validated_execution_request_printable_form_fields"
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
