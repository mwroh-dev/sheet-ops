{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheet-ops.local/contracts/requests/validated_execution_request.schema.json",
  "title": "ValidatedExecutionRequest",
  "type": "object",
  "required": [
    "scenario_id",
    "execution_kind",
    "composition_kind",
    "request_kind",
    "input_file",
    "source_sheet",
    "output_file"
  ],
  "properties": {
    "scenario_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "request_kind": {
      "enum": ["structured_use_request", "prompt_text"]
    },
    "request_text": { "type": "string", "minLength": 1 },
    "input_file": { "type": "string", "minLength": 1 },
    "source_sheet": { "type": "string", "minLength": 1 },
    "output_file": { "type": "string", "minLength": 1 },
    "execution_kind": { "const": "composition" },
    "composition_kind": { "enum": ["group_summary", "threshold_highlight", "join_lookup", "structured_row_append", "formula_extension", "period_copy", "data_validation", "formula_protection", "header_normalization", "period_roll_forward"] },
    "target_sheet": { "type": "string", "minLength": 1 },
    "summary_mode": { "enum": ["values", "formulas"] },
    "filters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["column", "op", "value"],
        "properties": {
          "column": { "type": "string", "minLength": 1 },
          "op": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "group_by": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["column", "op", "as"],
        "properties": {
          "column": { "type": "string", "minLength": 1 },
          "op": { "enum": ["sum", "count"] },
          "as": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "target_column": { "type": "string", "minLength": 1 },
    "operator": { "enum": [">", ">=", "<", "<=", "=", "=="] },
    "threshold": { "type": "number" },
    "highlight_color": { "type": "string", "minLength": 1 },
    "lookup_sheet": { "type": "string", "minLength": 1 },
    "join_key": { "type": "string", "minLength": 1 },
    "include_source_columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "append_lookup_columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cell", "value"],
        "properties": {
          "cell": { "type": "string", "minLength": 1 },
          "value": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "formula_source_row": {
      "type": "integer",
      "minimum": 1
    },
    "target_rows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "formula_columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "validation_rule": {
      "type": "object",
      "required": ["ranges", "rule_type", "allowed_values", "allow_blank"],
      "properties": {
        "ranges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rule_type": { "const": "list" },
        "allowed_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allow_blank": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "protection_rule": {
      "type": "object",
      "required": ["formula_ranges"],
      "properties": {
        "formula_ranges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "input_ranges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "password": { "type": "string" }
      },
      "additionalProperties": false
    },
    "header_row": {
      "type": "integer",
      "minimum": 1
    },
    "header_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "carry_forward_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from_cell", "to_cell"],
        "properties": {
          "from_sheet": { "type": "string", "minLength": 1 },
          "from_cell": { "type": "string", "minLength": 1 },
          "to_sheet": { "type": "string", "minLength": 1 },
          "to_cell": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "request_kind": { "const": "structured_use_request" } },
        "required": ["request_kind"]
      },
      "then": {
        "not": {
          "required": ["request_text"]
        }
      }
    },
    {
      "if": {
        "properties": { "request_kind": { "const": "prompt_text" } },
        "required": ["request_kind"]
      },
      "then": {
        "required": ["request_text"]
      }
    },
    {
      "if": {
        "properties": { "composition_kind": { "const": "group_summary" } },
        "required": ["composition_kind"]
      },
      "then": {
        "required": ["target_sheet", "summary_mode", "group_by", "metrics"],
        "not": {
          "anyOf": [
            { "required": ["target_column"] },
            { "required": ["operator"] },
            { "required": ["threshold"] },
            { "required": ["highlight_color"] },
            { "required": ["lookup_sheet"] },
            { "required": ["join_key"] },
            { "required": ["include_source_columns"] },
            { "required": ["append_lookup_columns"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "composition_kind": { "const": "threshold_highlight" } },
        "required": ["composition_kind"]
      },
      "then": {
        "required": ["target_column", "operator", "threshold"],
        "not": {
          "anyOf": [
            { "required": ["target_sheet"] },
            { "required": ["summary_mode"] },
            { "required": ["filters"] },
            { "required": ["group_by"] },
            { "required": ["metrics"] },
            { "required": ["lookup_sheet"] },
            { "required": ["join_key"] },
            { "required": ["include_source_columns"] },
            { "required": ["append_lookup_columns"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "composition_kind": { "const": "join_lookup" } },
        "required": ["composition_kind"]
      },
      "then": {
        "required": ["target_sheet", "lookup_sheet", "join_key", "append_lookup_columns"],
        "not": {
          "anyOf": [
            { "required": ["summary_mode"] },
            { "required": ["filters"] },
            { "required": ["group_by"] },
            { "required": ["metrics"] },
            { "required": ["target_column"] },
            { "required": ["operator"] },
            { "required": ["threshold"] },
            { "required": ["highlight_color"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "composition_kind": { "const": "structured_row_append" } },
        "required": ["composition_kind"]
      },
      "then": {
        "required": ["include_source_columns", "values"],
        "not": {
          "anyOf": [
            { "required": ["target_sheet"] },
            { "required": ["summary_mode"] },
            { "required": ["filters"] },
            { "required": ["group_by"] },
            { "required": ["metrics"] },
            { "required": ["target_column"] },
            { "required": ["operator"] },
            { "required": ["threshold"] },
            { "required": ["highlight_color"] },
            { "required": ["lookup_sheet"] },
            { "required": ["join_key"] },
            { "required": ["append_lookup_columns"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "composition_kind": { "const": "formula_extension" } },
        "required": ["composition_kind"]
      },
      "then": {
        "required": ["formula_source_row", "target_rows", "formula_columns"],
        "not": {
          "anyOf": [
            { "required": ["target_sheet"] },
            { "required": ["summary_mode"] },
            { "required": ["filters"] },
            { "required": ["group_by"] },
            { "required": ["metrics"] },
            { "required": ["target_column"] },
            { "required": ["operator"] },
            { "required": ["threshold"] },
            { "required": ["highlight_color"] },
            { "required": ["lookup_sheet"] },
            { "required": ["join_key"] },
            { "required": ["include_source_columns"] },
            { "required": ["append_lookup_columns"] },
            { "required": ["values"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "composition_kind": { "const": "data_validation" } },
        "required": ["composition_kind"]
      },
      "then": {
        "required": ["validation_rule"],
        "not": {
          "anyOf": [
            { "required": ["target_sheet"] },
            { "required": ["summary_mode"] },
            { "required": ["filters"] },
            { "required": ["group_by"] },
            { "required": ["metrics"] },
            { "required": ["target_column"] },
            { "required": ["operator"] },
            { "required": ["threshold"] },
            { "required": ["highlight_color"] },
            { "required": ["lookup_sheet"] },
            { "required": ["join_key"] },
            { "required": ["include_source_columns"] },
            { "required": ["append_lookup_columns"] },
            { "required": ["values"] },
            { "required": ["formula_source_row"] },
            { "required": ["target_rows"] },
            { "required": ["formula_columns"] },
            { "required": ["protection_rule"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "composition_kind": { "const": "period_copy" } },
        "required": ["composition_kind"]
      },
      "then": {
        "required": ["target_sheet"],
        "not": {
          "anyOf": [
            { "required": ["summary_mode"] },
            { "required": ["filters"] },
            { "required": ["group_by"] },
            { "required": ["metrics"] },
            { "required": ["target_column"] },
            { "required": ["operator"] },
            { "required": ["threshold"] },
            { "required": ["highlight_color"] },
            { "required": ["lookup_sheet"] },
            { "required": ["join_key"] },
            { "required": ["include_source_columns"] },
            { "required": ["append_lookup_columns"] },
            { "required": ["values"] },
            { "required": ["formula_source_row"] },
            { "required": ["target_rows"] },
            { "required": ["formula_columns"] },
            { "required": ["validation_rule"] },
            { "required": ["protection_rule"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "composition_kind": { "const": "formula_protection" } },
        "required": ["composition_kind"]
      },
      "then": {
        "required": ["protection_rule"],
        "not": {
          "anyOf": [
            { "required": ["target_sheet"] },
            { "required": ["summary_mode"] },
            { "required": ["filters"] },
            { "required": ["group_by"] },
            { "required": ["metrics"] },
            { "required": ["target_column"] },
            { "required": ["operator"] },
            { "required": ["threshold"] },
            { "required": ["highlight_color"] },
            { "required": ["lookup_sheet"] },
            { "required": ["join_key"] },
            { "required": ["include_source_columns"] },
            { "required": ["append_lookup_columns"] },
            { "required": ["values"] },
            { "required": ["formula_source_row"] },
            { "required": ["target_rows"] },
            { "required": ["formula_columns"] },
            { "required": ["validation_rule"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "composition_kind": { "const": "header_normalization" } },
        "required": ["composition_kind"]
      },
      "then": {
        "required": ["header_row", "header_mappings"],
        "not": {
          "anyOf": [
            { "required": ["target_sheet"] },
            { "required": ["summary_mode"] },
            { "required": ["filters"] },
            { "required": ["group_by"] },
            { "required": ["metrics"] },
            { "required": ["target_column"] },
            { "required": ["operator"] },
            { "required": ["threshold"] },
            { "required": ["highlight_color"] },
            { "required": ["lookup_sheet"] },
            { "required": ["join_key"] },
            { "required": ["include_source_columns"] },
            { "required": ["append_lookup_columns"] },
            { "required": ["values"] },
            { "required": ["formula_source_row"] },
            { "required": ["target_rows"] },
            { "required": ["formula_columns"] },
            { "required": ["validation_rule"] },
            { "required": ["protection_rule"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "composition_kind": { "const": "period_roll_forward" } },
        "required": ["composition_kind"]
      },
      "then": {
        "required": ["target_sheet", "carry_forward_mappings"],
        "not": {
          "anyOf": [
            { "required": ["summary_mode"] },
            { "required": ["filters"] },
            { "required": ["group_by"] },
            { "required": ["metrics"] },
            { "required": ["target_column"] },
            { "required": ["operator"] },
            { "required": ["threshold"] },
            { "required": ["highlight_color"] },
            { "required": ["lookup_sheet"] },
            { "required": ["join_key"] },
            { "required": ["include_source_columns"] },
            { "required": ["append_lookup_columns"] },
            { "required": ["values"] },
            { "required": ["formula_source_row"] },
            { "required": ["target_rows"] },
            { "required": ["formula_columns"] },
            { "required": ["validation_rule"] },
            { "required": ["protection_rule"] },
            { "required": ["header_row"] },
            { "required": ["header_mappings"] }
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
