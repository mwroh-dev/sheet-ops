{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheet-ops.local/contracts/requests/use_request.schema.json",
  "title": "UseRequest",
  "type": "object",
  "required": [
    "scenario_id",
    "request_text",
    "input_file",
    "sheet_name",
    "output_file"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "request_text": {
      "type": "string",
      "minLength": 1
    },
    "input_file": {
      "type": "string",
      "minLength": 1
    },
    "sheet_name": {
      "type": "string",
      "minLength": 1
    },
    "output_file": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "create_summary_sheet",
        "highlight_threshold_rows",
        "create_join_lookup_result_sheet",
        "append_structured_rows",
        "extend_table_formulas",
        "copy_period_sheet",
        "add_data_validation",
        "protect_formula_cells",
        "normalize_headers",
        "roll_forward_period",
        "reconcile_tables"
      ]
    },
    "target_sheet": {
      "type": "string",
      "minLength": 1
    },
    "summary_mode": {
      "enum": [
        "values",
        "formulas"
      ]
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "column",
          "op",
          "value"
        ],
        "properties": {
          "column": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "group_by": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "column",
          "op",
          "as"
        ],
        "properties": {
          "column": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "enum": [
              "sum",
              "count"
            ]
          },
          "as": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "target_column": {
      "type": "string",
      "minLength": 1
    },
    "operator": {
      "enum": [
        ">",
        ">=",
        "<",
        "<=",
        "=",
        "=="
      ]
    },
    "threshold": {
      "type": "number"
    },
    "highlight_color": {
      "type": "string",
      "minLength": 1
    },
    "lookup_sheet": {
      "type": "string",
      "minLength": 1
    },
    "join_key": {
      "type": "string",
      "minLength": 1
    },
    "include_source_columns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "append_lookup_columns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cell",
          "value"
        ],
        "properties": {
          "cell": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "formula_source_row": {
      "type": "integer",
      "minimum": 1
    },
    "target_rows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "formula_columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_rule": {
      "type": "object",
      "required": [
        "ranges",
        "rule_type",
        "allowed_values",
        "allow_blank"
      ],
      "properties": {
        "ranges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rule_type": {
          "const": "list"
        },
        "allowed_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allow_blank": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "protection_rule": {
      "type": "object",
      "required": [
        "formula_ranges"
      ],
      "properties": {
        "formula_ranges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "input_ranges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "password": {
          "type": "string"
        }
      },
      "additionalProperties": false
