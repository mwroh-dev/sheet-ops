{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheet-ops.local/contracts/results/subagent_loop_state.schema.json",
  "title": "SubagentLoopState",
  "type": "object",
  "required": ["scenario_id", "outcome", "parent_state", "specialists"],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": ["pass", "blocked"]
    },
    "parent_state": {
      "enum": ["DONE", "NEEDS_REVIEW", "BLOCKED", "AMBIGUOUS"]
    },
    "public_entry_status": {
      "enum": ["executed", "blocked", "needs_human_checkpoint"]
    },
    "work_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "specialists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "carrier",
          "model",
          "reasoning_effort",
          "state",
          "session_id",
          "spawn_completed_count",
          "wait_completed_count",
          "close_completed_count",
          "last_message"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "carrier": {
            "enum": ["default", "worker", "explorer"]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "reasoning_effort": {
            "enum": ["low", "medium", "high", "xhigh"]
          },
          "state": {
            "enum": ["DONE", "NEEDS_REVIEW", "BLOCKED", "AMBIGUOUS"]
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "spawn_completed_count": {
            "type": "integer",
            "minimum": 1
          },
          "wait_completed_count": {
            "type": "integer",
            "minimum": 1
          },
          "close_completed_count": {
            "type": "integer",
            "minimum": 1
          },
          "exit_code": {
            "type": ["integer", "null"]
          },
          "last_message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
