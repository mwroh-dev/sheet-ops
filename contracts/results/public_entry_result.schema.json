{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheet-ops.local/contracts/results/public_entry_result.schema.json",
  "title": "PublicEntryResult",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "command",
    "recoverable",
    "artifacts",
    "next_actions",
    "entry",
    "status",
    "work_unit_id",
    "request_compiler",
    "runtime"
  ],
  "properties": {
    "schema_version": {
      "const": "sheet-ops-cli/v1"
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "enum": ["run-prompt", "run-text", "run-intent"]
    },
    "recoverable": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fingerprints": {
      "$ref": "#/$defs/execution_fingerprints"
    },
    "entry": {
      "enum": ["run-prompt", "run-text", "run-intent"]
    },
    "status": {
      "enum": ["compiled", "needs_human_checkpoint", "blocked", "executed"]
    },
    "work_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "request_compiler": {
      "$ref": "#/$defs/request_compiler"
    },
    "runtime": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/public_runtime_result" }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["kind", "path", "required", "success_role"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "success_role": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "request_compiler": {
      "type": "object",
      "required": ["status", "request_dir", "decision_path", "generated_request_path"],
      "properties": {
        "status": {
          "enum": ["compiled", "needs_human_checkpoint", "blocked"]
        },
        "request_dir": {
          "type": "string",
          "minLength": 1
        },
        "decision_path": {
          "type": "string",
          "minLength": 1
        },
        "generated_request_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "execution_fingerprints": {
      "type": "object",
      "required": ["normalized_intent_sha256", "input_workbook_sha256"],
      "properties": {
        "normalized_intent_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_workbook_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_workbook_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "public_runtime_result": {
      "type": "object",
      "required": ["ids", "paths", "verification"],
      "properties": {
        "ids": {
          "type": "object",
          "required": ["run_id", "trace_id"],
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "trace_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "paths": {
          "type": "object",
          "required": ["evidence_dir"],
          "properties": {
            "telemetry_dir": { "type": "string" },
            "evidence_dir": {
              "type": "string",
              "minLength": 1
            },
            "report_dir": { "type": "string" },
            "request_path": { "type": "string" },
            "inspection_path": { "type": "string" },
            "plan_path": { "type": "string" },
            "policy_path": { "type": "string" },
            "task_spec_path": { "type": "string" },
            "operation_ir_path": { "type": "string" },
            "episode_path": { "type": "string" },
            "execution_path": { "type": "string" },
            "verification_path": { "type": "string" },
            "verification_review_path": { "type": "string" },
            "outcome_path": { "type": "string" },
            "failure_evidence_path": { "type": "string" },
            "repair_advice_path": { "type": "string" },
            "evidence_index": { "type": "string" },
            "report_path": { "type": "string" }
          },
          "additionalProperties": false
        },
        "inspection": { "type": "object" },
        "summary_inspection": { "type": ["object", "null"] },
        "plan": {},
        "policy": { "type": "object" },
        "execution": { "type": "object" },
        "episode": { "type": ["object", "null"] },
        "verification": {
          "type": "object",
          "required": ["pass", "operation", "output_file", "reasons"],
          "properties": {
            "pass": { "type": "boolean" },
            "operation": {
              "type": "string",
              "minLength": 1
            },
            "output_file": {
              "type": "string"
            },
            "output_workbook_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "reasons": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "pass": { "const": true }
                },
                "required": ["pass"]
              },
              "then": {
                "required": ["output_workbook_sha256"]
              }
            },
            {
              "if": {
                "properties": {
                  "output_file": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["output_file"]
              },
              "then": {
                "required": ["output_workbook_sha256"]
              }
            }
          ]
        },
        "verification_review": { "type": ["object", "null"] },
        "repair_advice": { "type": ["object", "null"] },
        "failure": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "executed" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["fingerprints"],
        "properties": {
          "recoverable": { "const": false },
          "request_compiler": {
            "allOf": [
              { "$ref": "#/$defs/request_compiler" },
              {
                "properties": {
                  "status": { "const": "compiled" },
                  "generated_request_path": { "minLength": 1 }
                },
                "required": ["status", "generated_request_path"]
              }
            ]
          },
          "artifacts": {
            "allOf": [
              {
                "contains": {
                  "allOf": [
                    { "$ref": "#/$defs/artifact" },
                    {
                      "properties": {
                        "kind": { "const": "verification" },
                        "required": { "const": true },
                        "success_role": { "const": "success_evidence" },
                        "path": { "minLength": 1 }
                      },
                      "required": ["kind", "required", "success_role", "path"]
                    }
                  ]
                },
                "minContains": 1
              },
              {
                "contains": {
                  "allOf": [
                    { "$ref": "#/$defs/artifact" },
                    {
                      "properties": {
                        "kind": { "const": "evidence_dir" },
                        "required": { "const": true },
                        "success_role": { "const": "audit_trail" },
                        "path": { "minLength": 1 }
                      },
                      "required": ["kind", "required", "success_role", "path"]
                    }
                  ]
                },
                "minContains": 1
              }
            ]
          },
          "runtime": { "$ref": "#/$defs/public_runtime_result" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "executed" },
          "ok": { "const": true }
        },
        "required": ["status", "ok"]
      },
      "then": {
        "properties": {
          "fingerprints": {
            "required": ["output_workbook_sha256"]
          },
          "artifacts": {
            "contains": {
              "allOf": [
                { "$ref": "#/$defs/artifact" },
                {
                  "properties": {
                    "kind": { "const": "output_workbook" },
                    "required": { "const": true },
                    "success_role": { "const": "primary_success" },
                    "path": { "minLength": 1 }
                  },
                  "required": ["kind", "required", "success_role", "path"]
                }
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "executed" },
          "ok": { "const": false }
        },
        "required": ["status", "ok"]
      },
      "then": {
        "properties": {
          "artifacts": {
            "items": {
              "if": {
                "properties": {
                  "kind": { "const": "output_workbook" }
                },
                "required": ["kind"]
              },
              "then": {
                "properties": {
                  "required": { "const": false },
                  "success_role": { "const": "failure_evidence" }
                },
                "required": ["required", "success_role"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "needs_human_checkpoint" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "ok": { "const": false },
          "recoverable": { "const": true },
          "request_compiler": {
            "allOf": [
              { "$ref": "#/$defs/request_compiler" },
              {
                "properties": {
                  "status": { "const": "needs_human_checkpoint" },
                  "generated_request_path": { "const": "" }
                },
                "required": ["status", "generated_request_path"]
              }
            ]
          },
          "runtime": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "blocked" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "ok": { "const": false },
          "recoverable": { "const": true },
          "request_compiler": {
            "allOf": [
              { "$ref": "#/$defs/request_compiler" },
              {
                "properties": {
                  "status": { "const": "blocked" },
                  "generated_request_path": { "const": "" }
                },
                "required": ["status", "generated_request_path"]
              }
            ]
          },
          "runtime": { "type": "null" }
        }
      }
    }
  ]
}
