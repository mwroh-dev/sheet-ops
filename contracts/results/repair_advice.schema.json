{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheet-ops.local/contracts/results/repair_advice.schema.json",
  "title": "RepairAdvice",
  "type": "object",
  "required": ["summary", "suggested_actions", "assumptions"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "failure_class": {
      "type": "string",
      "minLength": 1
    },
    "domain_code": {
      "type": "string",
      "minLength": 1
    },
    "repair_hint": {
      "type": "string",
      "minLength": 1
    },
    "suggested_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "dependentRequired": {
    "failure_class": ["domain_code", "repair_hint"],
    "domain_code": ["failure_class", "repair_hint"],
    "repair_hint": ["failure_class", "domain_code"]
  },
  "additionalProperties": false
}
