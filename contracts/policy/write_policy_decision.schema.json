    "preserve_original",
    "approval_required",
    "reasons"
  ],
  "properties": {
    "allow": {
      "type": "boolean"
    },
    "preserve_original": {
      "type": "boolean"
    },
    "approval_required": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
