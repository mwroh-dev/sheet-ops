{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheet-ops.local/contracts/template_research/verified_organism_classes.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_from_round",
    "authority",
    "summary",
    "classes"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "generated_from_round": { "type": "string", "minLength": 1 },
    "authority": { "type": "string", "const": "advisory_verified_class" },
    "summary": { "type": "string", "minLength": 1 },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/verified_class" }
    }
  },
  "$defs": {
    "atom_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "verified_class": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organism_id",
        "fixture_priority",
        "depth_focus",
        "runtime_atom_ids",
        "opportunity_atom_ids",
        "preview_evidence",
        "acceptance_criteria",
        "explicit_non_claims",
        "promotion_gate"
      ],
      "properties": {
        "organism_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "fixture_priority": {
          "type": "string",
          "enum": ["p2", "p3"]
        },
        "depth_focus": {
          "type": "string",
          "enum": [
            "deterministic_summary_depth",
            "matrix_status_depth",
            "calculation_schedule_depth"
          ]
        },
        "runtime_atom_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/atom_id" }
        },
        "opportunity_atom_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/atom_id" }
        },
        "preview_evidence": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "explicit_non_claims": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "promotion_gate": { "type": "string", "minLength": 1 }
      }
    }
  }
}
