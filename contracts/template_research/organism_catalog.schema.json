{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheet-ops.local/contracts/template_research/organism_catalog.schema.json",
  "title": "TemplateResearchOrganismCatalog",
  "type": "object",
  "$defs": {
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "organism": {
      "type": "object",
      "required": [
        "organism_id",
        "korean_name",
        "why",
        "primary_workflow",
        "required_molecule_ids",
        "supporting_atom_ids",
        "planned_or_unsupported_atom_ids",
        "verifier_focus",
        "fixture_priority",
        "advisory_status",
        "rationale"
      ],
      "properties": {
        "organism_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "korean_name": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "primary_workflow": {
          "type": "string",
          "minLength": 1
        },
        "required_molecule_ids": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "supporting_atom_ids": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "planned_or_unsupported_atom_ids": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "verifier_focus": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "fixture_priority": {
          "enum": [
            "p0",
            "p1",
            "p2",
            "p3"
          ]
        },
        "advisory_status": {
          "const": "advisory_only"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "generated_from_round",
    "authority",
    "summary",
    "organisms"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_from_round": {
      "const": "round-009"
    },
    "authority": {
      "const": "advisory_only"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "organisms": {
      "type": "array",
      "minItems": 21,
      "items": {
        "$ref": "#/$defs/organism"
      }
    }
  },
  "additionalProperties": false
}
