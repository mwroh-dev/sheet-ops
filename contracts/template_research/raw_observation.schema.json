{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheet-ops.local/contracts/template_research/raw_observation.schema.json",
  "title": "TemplateResearchRawObservation",
  "type": "object",
  "$defs": {
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "record_id",
    "source_name",
    "source_class",
    "source_url",
    "collected_at",
    "page_title",
    "category",
    "template_name",
    "description_summary",
    "terms_note",
    "observed_why",
    "observed_how",
    "input_output_shape"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "source_name": {
      "type": "string",
      "minLength": 1
    },
    "source_class": {
      "enum": [
        "free_template_site",
        "open_source_repo",
        "research_corpus"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "collected_at": {
      "type": "string",
      "format": "date"
    },
    "page_title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "template_name": {
      "type": "string",
      "minLength": 1
    },
    "description_summary": {
      "type": "string",
      "minLength": 1
    },
    "terms_note": {
      "type": "string",
      "minLength": 1
    },
    "observed_why": {
      "type": "string",
      "minLength": 1
    },
    "observed_how": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "input_output_shape": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
