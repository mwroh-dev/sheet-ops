{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheet-ops.local/contracts/template_research/pattern_hypotheses.schema.json",
  "title": "TemplateResearchPatternHypotheses",
  "type": "object",
  "$defs": {
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pattern_hypothesis": {
      "type": "object",
      "required": [
        "pattern_id",
        "title",
        "domain",
        "why",
        "triggers",
        "likely_existing_capabilities",
        "likely_missing_capabilities",
        "evidence_status"
      ],
      "properties": {
        "pattern_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "triggers": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "likely_existing_capabilities": {
          "$ref": "#/$defs/string_array"
        },
        "likely_missing_capabilities": {
          "$ref": "#/$defs/string_array"
        },
        "evidence_status": {
          "const": "hypothesis_only"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "purpose",
    "patterns"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "patterns": {
      "type": "array",
      "minItems": 30,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pattern_hypothesis"
      }
    }
  },
  "additionalProperties": false
}
