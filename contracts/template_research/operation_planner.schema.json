{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheet-ops.local/contracts/template_research/operation_planner.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "authority", "summary", "plans"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "authority": { "type": "string", "const": "advisory_planner_contract" },
    "summary": { "type": "string", "minLength": 1 },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/plan" }
    }
  },
  "$defs": {
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organism_id",
        "classification_signals",
        "operation_sequence_atom_ids",
        "required_verifier_spec_ids",
        "fallback_policy"
      ],
      "properties": {
        "organism_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "classification_signals": { "$ref": "#/$defs/non_empty_strings" },
        "operation_sequence_atom_ids": { "$ref": "#/$defs/non_empty_strings" },
        "required_verifier_spec_ids": { "$ref": "#/$defs/non_empty_strings" },
        "fallback_policy": { "type": "string", "minLength": 1 }
      }
    }
  }
}
