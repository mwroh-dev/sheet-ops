        }
      },
      "additionalProperties": false
    },
    "data_validation_rule": {
      "type": "object",
      "required": [
        "ranges",
        "rule_type",
        "allowed_values",
        "allow_blank"
      ],
      "properties": {
        "ranges": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "rule_type": {
          "const": "list"
        },
        "allowed_values": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "allow_blank": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "formula_protection_rule": {
      "type": "object",
      "required": [
        "formula_ranges"
      ],
      "properties": {
        "formula_ranges": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "input_ranges": {
          "$ref": "#/$defs/non_empty_string_array"
