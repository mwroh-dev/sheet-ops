    "composition_kind": {
      "enum": [
        "group_summary",
        "threshold_highlight",
        "join_lookup",
        "structured_row_append",
        "formula_extension",
        "period_copy",
        "data_validation",
        "formula_protection",
        "header_normalization",
        "period_roll_forward",
        "table_reconciliation",
        "printable_form"
