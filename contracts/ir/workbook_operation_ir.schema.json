    },
    {
      "$ref": "#/$defs/workbook_operation_ir_copy_period_sheet"
    },
    {
      "$ref": "#/$defs/workbook_operation_ir_protect_formula_cells"
    },
    {
      "$ref": "#/$defs/workbook_operation_ir_normalize_headers"
    },
    {
      "$ref": "#/$defs/workbook_operation_ir_roll_forward_period"
