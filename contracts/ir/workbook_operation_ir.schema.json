        "op": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "metric_spec": {
      "type": "object",
      "required": [
        "column",
        "op",
        "as"
      ],
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "sum",
            "count"
          ]
        },
        "as": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "cell_value": {
      "type": "object",
      "required": [
        "cell",
        "value"
      ],
      "properties": {
        "cell": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "null"
