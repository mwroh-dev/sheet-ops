    "workbook_operation_ir_group_summarize_fields": {
      "type": "object",
      "required": [
        "operation_family",
        "composition_kind",
          "source_sheet",
          "group_by",
          "metrics",
          "target_sheet",
        "summary_mode"
      ],
      "properties": {
        "operation_family": {
          "const": "group_summarize"
        },
        "source_sheet": {
          "type": "string",
          "minLength": 1
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filter_spec"
          }
        },
        "group_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metric_spec"
          }
        },
        "target_sheet": {
          "type": "string",
          "minLength": 1
