      "type": "object",
      "required": [
        "execution_kind",
        "operation_family",
        "preserve_original"
      ],
      "properties": {
        "execution_kind": {
          "enum": [
            "composition",
            "primitive"
          ]
        },
        "operation_family": {
          "enum": [
            "group_summarize",
            "highlight_threshold",
            "join_lookup",
            "append_structured_rows",
            "extend_table_formulas",
            "copy_period_sheet",
            "add_data_validation",
            "protect_formula_cells",
            "normalize_headers",
            "roll_forward_period",
            "write_values",
            "reconcile_tables",
            "generate_printable_form"
          ]
        },
        "preserve_original": {
          "type": "boolean"
        }
      }
