  "$defs": {
    "filter_spec": {
      "type": "object",
      "required": [
        "column",
        "op",
        "value"
      ],
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "metric_spec": {
      "type": "object",
      "required": [
        "column",
        "op",
        "as"
      ],
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "sum",
            "count"
          ]
        },
        "as": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "cell_value": {
      "type": "object",
      "required": [
        "cell",
        "value"
      ],
      "properties": {
        "cell": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "data_validation_rule": {
      "type": "object",
      "required": [
        "ranges",
        "rule_type",
        "allowed_values",
        "allow_blank"
      ],
      "properties": {
        "ranges": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "rule_type": {
          "const": "list"
        },
        "allowed_values": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "allow_blank": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "formula_protection_rule": {
      "type": "object",
      "required": [
        "formula_ranges"
      ],
      "properties": {
        "formula_ranges": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "input_ranges": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "password": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "header_mapping": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "carry_forward_mapping": {
      "type": "object",
      "required": [
        "from_cell",
        "to_cell"
      ],
      "properties": {
        "from_sheet": {
          "type": "string",
          "minLength": 1
        },
        "from_cell": {
          "type": "string",
          "minLength": 1
        },
        "to_sheet": {
          "type": "string",
          "minLength": 1
        },
        "to_cell": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compare_mapping": {
      "type": "object",
      "required": [
        "left_column",
        "right_column"
