{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheet-ops.local/contracts/cli/preview_request_result.schema.json",
  "title": "SheetOpsCLIPreviewRequestResult",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "read_only",
    "dry_run",
    "scenario_id",
    "input_file",
    "output_file",
    "state_root",
    "planned_reads",
    "planned_writes",
    "planned_artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "sheet-ops-cli/v1" },
    "command": { "const": "preview-request" },
    "ok": { "const": true },
    "read_only": { "const": true },
    "dry_run": { "const": false },
    "scenario_id": { "type": "string", "minLength": 1 },
    "input_file": { "type": "string", "minLength": 1 },
    "output_file": { "type": "string", "minLength": 1 },
    "state_root": { "type": "string", "minLength": 1 },
    "planned_reads": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/planned_artifact" }
    },
    "planned_writes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/planned_artifact" }
    },
    "planned_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/planned_artifact" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "planned_artifact": {
      "type": "object",
      "required": ["kind", "path", "required"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
