{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheet-ops.local/contracts/cli/error_envelope.schema.json",
  "title": "SheetOpsCLIErrorEnvelope",
  "type": "object",
  "required": ["schema_version", "ok", "error"],
  "properties": {
    "schema_version": { "const": "sheet-ops-cli/v1" },
    "ok": { "const": false },
    "error": {
      "type": "object",
      "required": ["code", "message", "recoverable", "suggested_commands", "exit_code"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "recoverable": { "type": "boolean" },
        "suggested_commands": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exit_code": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
