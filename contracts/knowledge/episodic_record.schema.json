{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EpisodicRecord",
  "type": "object",
  "required": [
    "agent_namespace",
    "run_id",
    "recorded_at",
    "summary"
  ],
  "properties": {
    "agent_namespace": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "failure_class": {
      "type": "string",
      "minLength": 1
    },
    "domain_code": {
      "type": "string",
      "minLength": 1
    },
    "critical_step": {
      "type": "string",
      "minLength": 1
    },
    "repair_hint": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "agent_namespace": {
            "const": "knowledge/orchestrator/episodic"
          }
        },
        "required": [
          "agent_namespace"
        ]
      },
      "then": {
        "required": [
          "scenario_id",
          "operation",
          "outcome"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "phase"
              ]
            },
            {
              "required": [
                "failure_class"
              ]
            },
            {
              "required": [
                "domain_code"
              ]
            },
            {
              "required": [
                "critical_step"
              ]
            },
            {
              "required": [
                "repair_hint"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_namespace": {
            "const": "knowledge/verification/episodic/failures"
          }
        },
        "required": [
          "agent_namespace"
        ]
      },
      "then": {
        "required": [
          "scenario_id",
          "operation",
          "outcome",
          "phase",
          "failure_class",
          "domain_code",
          "critical_step"
        ],
        "properties": {
          "outcome": {
            "const": "fail"
          },
          "phase": {
            "const": "verification"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
