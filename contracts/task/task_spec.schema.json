{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskSpec",
  "type": "object",
  "$defs": {
    "source_spec": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "case_markdown"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "natural_language"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "filter_spec": {
      "type": "object",
      "required": [
        "column",
        "op",
        "value"
      ],
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "metric_spec": {
      "type": "object",
      "required": [
        "column",
        "op",
        "as"
      ],
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "sum",
            "count"
          ]
        },
        "as": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "threshold_rule": {
      "type": "object",
      "required": [
        "column",
        "operator",
        "threshold",
        "highlight_color"
      ],
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            ">",
            ">=",
            "<",
            "<=",
            "="
          ]
        },
        "threshold": {
          "type": "number"
        },
        "highlight_color": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "cell_value": {
      "type": "object",
      "required": [
        "cell",
        "value"
      ],
      "properties": {
        "cell": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "request_kind",
    "execution_kind",
    "source",
    "input_workbook",
    "output_workbook",
    "operation",
    "source_sheet"
  ],
  "properties": {
    "request_kind": {
      "const": "workbook_case"
    },
    "execution_kind": {
      "const": "composition"
    },
    "composition_kind": {
      "enum": [
        "group_summary",
        "threshold_highlight",
        "join_lookup",
        "structured_row_append"
      ]
    },
    "source": {
      "$ref": "#/$defs/source_spec"
    },
    "request_text": {
      "type": "string",
      "minLength": 1
    },
    "input_workbook": {
      "type": "string",
      "minLength": 1
    },
    "output_workbook": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "create_summary_sheet",
        "highlight_threshold_rows",
        "create_join_lookup_result_sheet",
        "append_structured_rows"
      ]
    },
    "source_sheet": {
      "type": "string",
      "minLength": 1
    },
    "target_sheet": {
      "type": "string",
      "minLength": 1
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/filter_spec"
      }
    },
    "group_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric_spec"
      }
    },
    "summary_mode": {
      "enum": [
        "values",
        "formulas"
      ]
    },
    "threshold_rule": {
      "$ref": "#/$defs/threshold_rule"
    },
    "lookup_sheet": {
      "type": "string",
      "minLength": 1
    },
    "join_key": {
      "type": "string",
      "minLength": 1
    },
    "include_source_columns": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "append_lookup_columns": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cell_value"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "natural_language"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "request_text"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "case_markdown"
              }
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "request_text"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "create_summary_sheet"
          }
        }
      },
      "then": {
        "properties": {
          "execution_kind": {
            "const": "composition"
          },
          "composition_kind": {
            "const": "group_summary"
          }
        },
        "required": [
          "composition_kind",
          "target_sheet",
          "group_by",
          "metrics",
          "summary_mode"
        ],
        "not": {
          "required": [
            "threshold_rule"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "highlight_threshold_rows"
          }
        }
      },
      "then": {
        "properties": {
          "execution_kind": {
            "const": "composition"
          },
          "composition_kind": {
            "const": "threshold_highlight"
          }
        },
        "required": [
          "composition_kind",
          "threshold_rule"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "target_sheet"
              ]
            },
            {
              "required": [
                "filters"
              ]
            },
            {
              "required": [
                "group_by"
              ]
            },
            {
              "required": [
                "metrics"
              ]
            },
            {
              "required": [
                "summary_mode"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "create_join_lookup_result_sheet"
          }
        }
      },
      "then": {
        "properties": {
          "execution_kind": {
            "const": "composition"
          },
          "composition_kind": {
            "const": "join_lookup"
          }
        },
        "required": [
          "composition_kind",
          "lookup_sheet",
          "join_key",
          "target_sheet",
          "include_source_columns",
          "append_lookup_columns"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "filters"
              ]
            },
            {
              "required": [
                "group_by"
              ]
            },
            {
              "required": [
                "metrics"
              ]
            },
            {
              "required": [
                "summary_mode"
              ]
            },
            {
              "required": [
                "threshold_rule"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "append_structured_rows"
          }
        }
      },
      "then": {
        "properties": {
          "execution_kind": {
            "const": "composition"
          },
          "composition_kind": {
            "const": "structured_row_append"
          }
        },
        "required": [
          "composition_kind",
          "include_source_columns",
          "values"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "target_sheet"
              ]
            },
            {
              "required": [
                "filters"
              ]
            },
            {
              "required": [
                "group_by"
              ]
            },
            {
              "required": [
                "metrics"
              ]
            },
            {
              "required": [
                "summary_mode"
              ]
            },
            {
              "required": [
                "threshold_rule"
              ]
            },
            {
              "required": [
                "lookup_sheet"
              ]
            },
            {
              "required": [
                "join_key"
              ]
            },
            {
              "required": [
                "append_lookup_columns"
              ]
            }
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
