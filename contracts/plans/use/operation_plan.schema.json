{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UseOperationPlan",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "operation",
        "sheet_name",
        "target_column",
        "operator",
        "threshold",
        "highlight_color",
        "preserve_original",
        "output_file"
      ],
      "properties": {
        "operation": {
          "const": "highlight_threshold_rows"
        },
        "sheet_name": {
          "type": "string"
        },
        "target_column": {
          "type": "string"
        },
        "operator": {
          "enum": [
            ">",
            ">=",
            "<",
            "<=",
            "="
          ]
        },
        "threshold": {
          "type": "number"
        },
        "highlight_color": {
          "type": "string"
        },
        "preserve_original": {
          "type": "boolean"
        },
        "output_file": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "operation",
        "sheet_name",
        "summary_mode",
        "group_by",
        "metrics",
        "target_sheet",
        "preserve_original",
        "output_file"
      ],
      "properties": {
        "operation": {
          "const": "create_summary_sheet"
        },
        "sheet_name": {
          "type": "string"
        },
        "summary_mode": {
          "enum": [
            "values",
            "formulas"
          ]
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "column",
              "op",
              "value"
            ],
            "properties": {
              "column": {
                "type": "string"
              },
              "op": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "group_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "column",
              "op",
              "as"
            ],
            "properties": {
              "column": {
                "type": "string"
              },
              "op": {
                "enum": [
                  "sum",
                  "count"
                ]
              },
              "as": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "target_sheet": {
          "type": "string"
        },
        "preserve_original": {
          "type": "boolean"
        },
        "output_file": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "operation",
        "sheet_name",
        "lookup_sheet",
        "join_key",
        "target_sheet",
        "include_source_columns",
        "append_lookup_columns",
        "preserve_original",
        "output_file"
      ],
      "properties": {
        "operation": {
          "const": "create_join_lookup_result_sheet"
        },
        "sheet_name": {
          "type": "string"
        },
        "lookup_sheet": {
          "type": "string"
        },
        "join_key": {
          "type": "string"
        },
        "target_sheet": {
          "type": "string"
        },
        "include_source_columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "append_lookup_columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "preserve_original": {
          "type": "boolean"
        },
        "output_file": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "operation",
        "sheet_name",
        "include_source_columns",
        "values",
        "preserve_original",
        "output_file"
      ],
      "properties": {
        "operation": {
          "const": "append_structured_rows"
        },
        "sheet_name": {
          "type": "string"
        },
        "include_source_columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "cell",
              "value"
            ],
            "properties": {
              "cell": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "preserve_original": {
          "type": "boolean"
        },
        "output_file": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "operation",
        "sheet_name",
        "formula_source_row",
        "target_rows",
        "formula_columns",
        "preserve_original",
        "output_file"
      ],
      "properties": {
        "operation": {
          "const": "extend_table_formulas"
        },
        "sheet_name": {
          "type": "string"
        },
        "formula_source_row": {
          "type": "integer",
          "minimum": 1
        },
        "target_rows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "formula_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "preserve_original": {
          "type": "boolean"
        },
        "output_file": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "operation",
        "sheet_name",
        "validation_rule",
        "preserve_original",
        "output_file"
      ],
      "properties": {
        "operation": {
          "const": "add_data_validation"
        },
        "sheet_name": {
          "type": "string"
        },
        "validation_rule": {
          "type": "object",
          "required": ["ranges", "rule_type", "allowed_values", "allow_blank"],
          "properties": {
            "ranges": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "rule_type": {
              "const": "list"
            },
            "allowed_values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "allow_blank": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "preserve_original": {
          "type": "boolean"
        },
        "output_file": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "operation",
        "sheet_name",
        "protection_rule",
        "preserve_original",
        "output_file"
      ],
      "properties": {
        "operation": {
          "const": "protect_formula_cells"
        },
        "sheet_name": {
          "type": "string"
        },
        "protection_rule": {
          "type": "object",
          "required": ["formula_ranges"],
          "properties": {
            "formula_ranges": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "input_ranges": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "password": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "preserve_original": {
          "type": "boolean"
        },
        "output_file": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  ]
}
