{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionEpisode",
  "type": "object",
  "required": [
    "task_spec_path",
    "operation_ir_path",
    "execution_path",
    "verification_path",
    "outcome"
  ],
  "properties": {
    "task_spec_path": {
      "type": "string",
      "minLength": 1
    },
    "operation_ir_path": {
      "type": "string",
      "minLength": 1
    },
    "execution_path": {
      "type": "string",
      "minLength": 1
    },
    "verification_path": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "pass",
        "fail"
      ]
    }
  },
  "additionalProperties": false
}
