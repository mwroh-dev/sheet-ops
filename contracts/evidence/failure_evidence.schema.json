{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FailureEvidence",
  "type": "object",
  "required": [
    "scenario_id",
    "run_id",
    "operation",
    "phase",
    "failure_class",
    "domain_code",
    "message",
    "outcome",
    "critical_step",
    "telemetry",
    "request_path",
    "runtime_version"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "failure_class": {
      "type": "string",
      "minLength": 1
    },
    "domain_code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "const": "fail"
    },
    "critical_step": {
      "type": "string",
      "minLength": 1
    },
    "telemetry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Paths to raw telemetry streams retained for the failed run."
    },
    "request_path": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the request artifact for the failed run."
    },
    "task_spec_path": {
      "type": "string",
      "minLength": 1
    },
    "operation_ir_path": {
      "type": "string",
      "minLength": 1
    },
    "plan_path": {
      "type": "string",
      "minLength": 1
    },
    "policy_path": {
      "type": "string",
      "minLength": 1
    },
    "verification_path": {
      "type": "string",
      "minLength": 1
    },
    "verification_review_path": {
      "type": "string",
      "minLength": 1
    },
    "execution_path": {
      "type": "string",
      "minLength": 1
    },
    "outcome_path": {
      "type": "string",
      "minLength": 1
    },
    "repair_advice_path": {
      "type": "string",
      "minLength": 1
    },
    "runtime_version": {
      "type": "object",
      "required": [
        "schema_version",
        "runtime_name"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "runtime_name": {
          "type": "string",
          "minLength": 1
        },
        "runtime_commit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
